{
  "name": "oxlint-config-presets",
  "version": "0.1.10",
  "description": "Oxlint configurations ported from popular ESLint styleguides",
  "keywords": [
    "config",
    "eslint",
    "lint",
    "oxlint",
    "styleguide"
  ],
  "homepage": "https://github.com/popup-plus/oxlint-config-presets#readme",
  "bugs": {
    "url": "https://github.com/popup-plus/oxlint-config-presets/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popup-plus/oxlint-config-presets.git"
  },
  "type": "module",
  "exports": {
    "./*.json": {
      "types": "./oxlint-config.d.ts",
      "default": "./*.json"
    }
  },
  "publishConfig": {
    "directory": "configs"
  },
  "scripts": {
    "before-commit": "pnpm generate && pnpm test && pnpm oxlint",
    "fmt": "oxfmt",
    "generate": "rm -rf configs && node --import tsx/esm scripts/generate.ts && oxfmt",
    "oxlint": "oxlint",
    "prepack": "node --import tsx/esm scripts/prepack.ts",
    "test": "node --import tsx/esm --test tests/*.test.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@eslint/js": "^10.0.1",
    "@oxlint/migrate": "^1.65.0",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-alloy": "^5.1.2",
    "eslint-config-eslint": "^14.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-hardcore": "^49.0.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-problems": "^10.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-wikimedia": "^0.32.4",
    "eslint-config-xo": "^0.51.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint8": "npm:eslint@^8.57.1",
    "next": "^16.2.6",
    "oxfmt": "^0.50.0",
    "oxlint": "1.65.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "oxlint": ">=0.15.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.29.3"
}
