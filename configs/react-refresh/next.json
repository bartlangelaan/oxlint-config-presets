{
  "plugins": ["react"],
  "rules": {
    "react/only-export-components": [
      "error",
      {
        "allowExportNames": [
          "experimental_ppr",
          "dynamic",
          "dynamicParams",
          "revalidate",
          "fetchCache",
          "runtime",
          "preferredRegion",
          "maxDuration",
          "metadata",
          "generateMetadata",
          "viewport",
          "generateViewport",
          "generateImageMetadata",
          "generateSitemaps",
          "generateStaticParams"
        ]
      }
    ]
  }
}
